$folder = "D:\WRENCH LOTS RELEASE\wrench LOT-19 226 WORKING"

Get-ChildItem -Path $folder -File | ForEach-Object {
    if ($_.Name -match "(?i)^(.*?)[_-]R\d+[_-].*$") {
        $newName = $matches[1] + $_.Extension
        $destinationPath = Join-Path $folder $newName

        if (-not (Test-Path -Path $destinationPath)) {
            Rename-Item -Path $_.FullName -NewName $newName
        } else {
            Write-Host "Skipped (Already Exists): $newName" -ForegroundColor Yellow
        }
    }
}
