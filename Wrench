$source =D:\WRENCH LOTS RELEASE\WRENCH LOT 18 SHARAYU 284 WORKING
$destination =D:\WRENCH LOTS RELEASE\WRENCH LOT 18 SHARAYU 284 WORKING

Get-ChildItem -Path $source -File | ForEach-Object {
    if ($_.Name -match "^(.*?)(_R\d+_.*)$") {
        $newName = $matches[1] + $_.Extension
    } else {
        $newName = $_.Name
    }
    Copy-Item -Path $_.FullName -Destination (Join-Path $destination $newName)
}
